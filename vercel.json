{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "veyra-2.0",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "veyra-2.0/frontend",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "VITE_API_BASE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
